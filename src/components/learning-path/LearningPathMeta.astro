---
import ContentMeta from '../content/ContentMeta.astro';
import { formatEstimatedDuration } from '../../lib/duration';

interface Props {
  level: string;
  estimatedMinutes: number;
}

const { level, estimatedMinutes } = Astro.props;
const duration = formatEstimatedDuration(estimatedMinutes, estimatedMinutes >= 60);
const items = [
  { label: 'Level', value: level },
  { label: 'Estimated time', value: duration },
];
---

<div data-learning-path-meta>
  <ContentMeta items={items} />
  <p class="time-note" data-learning-path-time-note>The total includes setup, note-taking, reviewing results, and repetition. Individual step times cover the work in that Testing method or Exercise.</p>
</div>

<style>
  .time-note {
    max-width: 42rem;
    margin-block: 0.5rem 0;
    font-size: 1rem;
  }
</style>
