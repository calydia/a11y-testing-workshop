---
import DarkLogo from '../../icons/a11ying-dark.svg';
import LightLogo from '../../icons/a11ying-light.svg';
---
<div class="max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-3 clear-both md:gap-8 lg:clear-none">
  <a href="/" class="inline-block border-y-4 border-transparent p-2 hover:border-y-4 hover:border-lt-purple dark:hover:border-dk-blue-light focus:outline focus:outline-2 focus:outline-offset-4 focus:outline-black dark:focus:outline-white">
    <DarkLogo class="logo-dark" height="173" width="348" aria-hidden="true" />
    <LightLogo class="logo-light" height="173" width="348" aria-hidden="true" />
    <span class="sr-only">Accessibility Testing Lab home</span>
  </a>
  <div>
    <span class="block text-xl font-title text-black dark:text-white dark:text-shadow-text md:text-4xl">Accessibility Testing Lab</span>
    <span class="block text-xs mt-1 leading-none text-blue-tory dark:text-lt-perfume dark:text-shadow-text md:text-base">A hands-on environment for practising accessibility testing</span>
  </div>
</div>
