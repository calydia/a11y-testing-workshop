---
interface Props { title: string; metaDescription: string; noindex?: boolean }
const { title, metaDescription, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL('/social-media-share.jpg', Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Accessibility Testing Lab',
  url: 'https://testing.a11y.ing/',
};
---
<title>{title} | Accessibility Testing Lab</title>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={metaDescription} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="en" />
<meta property="og:site_name" content="Accessibility Testing Lab" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={socialImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content="A11ying with Sanna" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={socialImageUrl} />
<meta name="twitter:image:alt" content="A11ying with Sanna" />
<link rel="canonical" href={canonicalUrl} />
<link rel="shortcut icon" href="/favicons/favicon.ico" type="image/x-icon" />
<link rel="icon" href="/favicons/favicon.ico" type="image/x-icon" />
<link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicons/favicon-96x96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.json" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#BBC9F7" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
