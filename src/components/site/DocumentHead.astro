---
interface Props { title: string; metaDescription: string }
const { title, metaDescription } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Accessibility Testing Lab',
  url: 'https://testing.a11y.ing/',
};
---
<title>{title} | Accessibility Testing Lab</title>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={metaDescription} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="en" />
<meta property="og:site_name" content="Accessibility Testing Lab" />
<meta property="og:url" content={canonicalUrl} />
<link rel="canonical" href={canonicalUrl} />
<link rel="shortcut icon" href="/favicons/favicon.ico" type="image/x-icon" />
<link rel="icon" href="/favicons/favicon.ico" type="image/x-icon" />
<link rel="manifest" href="/manifest.json" />
<link rel="sitemap" href="/sitemap-index.xml" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
