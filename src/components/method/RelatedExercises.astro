---
export interface RelatedExerciseView {
  title: string;
  summary: string;
  href: string;
  estimatedMinutes: number;
}

interface Props {
  exercises: RelatedExerciseView[];
}

const { exercises } = Astro.props;
---

{exercises.length > 0 && (
  <section aria-labelledby="related-exercises-heading" data-related-exercises>
    <h2 id="related-exercises-heading">Practise this method</h2>
    <ul class="related-exercises" role="list">
      {exercises.map((exercise) => (
        <li>
          <h3><a href={exercise.href}>{exercise.title}</a></h3>
          <p data-related-exercise-summary>{exercise.summary}</p>
          <p data-related-exercise-time><strong>Estimated time:</strong> {exercise.estimatedMinutes} minutes</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-exercises {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .related-exercises li {
    margin: 0;
    padding: 1rem;
    border: 2px solid #bbc9f7;
  }

  .related-exercises h3,
  .related-exercises p {
    margin-block: 0 0.5rem;
  }

  .related-exercises h3 {
    font-size: 1.25rem;
  }

  .related-exercises p {
    font-size: 1.125rem;
  }

  :global(.dark) .related-exercises li {
    border-color: #18399a;
  }
</style>
