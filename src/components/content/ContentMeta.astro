---
interface MetaItem {
  label: string;
  value: string;
}

interface Props {
  items: MetaItem[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <dl class="mb-8 flex flex-wrap gap-x-8 gap-y-2 text-base">
    {items.map(({ label, value }) => (
      <div>
        <dt class="inline font-bold">{label}:</dt>
        {' '}
        <dd class="inline">{value}</dd>
      </div>
    ))}
  </dl>
)}
