---
export interface ContentCardData {
  href: string;
  title: string;
  summary: string;
  eyebrow?: string;
  level?: string;
  estimatedMinutes?: number;
}

export type ContentCardVariant = 'default' | 'sectionLanding';

interface Props extends ContentCardData {
  variant?: ContentCardVariant;
  headingLevel?: 2 | 3;
}

const { href, title, summary, eyebrow, level, estimatedMinutes, variant = 'default', headingLevel = 2 } = Astro.props as Props;
import { formatEstimatedDuration } from '../../lib/duration';
const displayLevel = level ? `${level.charAt(0).toUpperCase()}${level.slice(1)}` : undefined;
const duration = estimatedMinutes ? formatEstimatedDuration(estimatedMinutes, true) : undefined;
---

<article class="h-full border-2 border-lt-code-border bg-lt-blue-middle p-6 dark:border-dk-code-border dark:bg-dk-code-bg">
  {eyebrow && <p class="mb-2 text-base font-bold">{eyebrow}</p>}
  {headingLevel === 3 ? (
    <h3 class:list={["mt-0", variant === 'sectionLanding' ? 'section-landing-card-heading' : 'text-2xl']}><a href={href}>{title}</a></h3>
  ) : (
    <h2 class:list={["mt-0", variant === 'sectionLanding' ? 'section-landing-card-heading' : 'text-2xl']}><a href={href}>{title}</a></h2>
  )}
  {(displayLevel || duration) && (
    <p class:list={["mb-3 mt-0", variant === 'sectionLanding' ? 'section-landing-card-meta' : 'text-base']} data-content-card-meta>
      {displayLevel && <span data-content-card-level>{displayLevel}</span>}
      {displayLevel && duration && <span aria-hidden="true" data-content-card-separator> · </span>}
      {duration && <span data-content-card-duration>{duration}</span>}
    </p>
  )}
  <p class:list={[variant === 'sectionLanding' ? 'mb-4 section-landing-card-summary' : 'mb-0']}>{summary}</p>
</article>

<style>
  .section-landing-card-heading {
    font-size: 1.25rem;
  }

  .section-landing-card-summary {
    font-size: 1rem;
  }

  .section-landing-card-meta {
    font-size: 0.875rem;
  }
</style>
