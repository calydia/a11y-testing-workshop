---
import { Image } from 'astro:assets';
import speakerPhoto from '../../../images/man-working.jpg';
---

<main class="conference-shell">
  <a class="return-link" href="/journeys/reviewing-a-community-conference-programme/">Return to the Testing journey</a>

  <header class="conference-header">
    <div>
      <p class="eyebrow">Community Futures Conference</p>
      <h1>Ideas for a more inclusive city</h1>
      <p>Explore two days of talks, practical sessions, and community-led discussions in Helsinki.</p>
    </div>
    <svg class="header-mark" aria-hidden="true" viewBox="0 0 120 120" focusable="false">
      <circle cx="60" cy="60" r="52"></circle>
      <path d="M30 70 52 46l15 16 22-26"></path>
    </svg>
  </header>

  <section class="venue" aria-labelledby="venue-heading">
    <div>
      <h2 id="venue-heading">Venue and arrival</h2>
      <p>The conference takes place at Harbor Hall, beside the eastern tram entrance. Step-free access is available from the waterside entrance.</p>
      <a class="venue-link" href="#venue-information" aria-label="Harbor Hall venue and arrival information">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Zm0 10a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"></path></svg>
        Venue information
      </a>
    </div>
    <img src="/images/community-conference-venue.svg" alt="Harbor Hall's waterside entrance beside the tram stop" width="640" height="400" />
  </section>

  <section aria-labelledby="programme-heading">
    <h2 id="programme-heading" tabindex="-1">Programme</h2>
    <p>Choose sessions to build a personal schedule. Times use Eastern European Summer Time.</p>

    <section class="programme-day" aria-labelledby="friday-heading">
      <h3 id="friday-heading">Friday</h3>

      <article class="session-card">
        <p class="session-time">09:30</p>
        <h4>Keynote: Designing public spaces with communities</h4>
        <div class="speaker">
          <Image src={speakerPhoto} alt="Speaker at the conference" width={180} />
          <p><strong>Speaker:</strong> Aino Laine, community designer</p>
        </div>
        <p>A practical keynote about involving residents in decisions that shape shared spaces.</p>
        <p>Finnish session introduction: Tervetuloa rakentamaan kaikille kuuluvaa kaupunkia.</p>
        <div class="session-actions">
          <a href="#session-details" data-session="keynote">Session details</a>
          <button class="schedule-button" type="button" data-schedule="keynote">
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M11 5h2v14h-2zM5 11h14v2H5z"></path></svg>
          </button>
          <span class="schedule-status" data-schedule-status="keynote"></span>
        </div>
      </article>

      <article class="session-card">
        <p class="session-time">11:15</p>
        <h5>Making neighbourhood data understandable</h5>
        <p><strong>Speaker:</strong> Leo Niemi, civic-data specialist</p>
        <p>Explore ways to turn complex local data into useful stories and decisions.</p>
        <p lang="sv">Sessionen innehåller en kort sammanfattning på svenska.</p>
        <div class="session-actions">
          <a href="#session-details" data-session="data-stories">Session details</a>
          <button type="button" class="named-action">
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="m5 12 4 4L19 6"></path></svg>
            Add data session to schedule
          </button>
        </div>
      </article>
    </section>

    <section class="programme-day" aria-labelledby="saturday-heading">
      <h3 id="saturday-heading">Saturday</h3>
      <article class="session-card">
        <p class="session-time">10:00</p>
        <h5>Accessible culture in everyday places</h5>
        <p><strong>Speaker:</strong> Samira Noor, cultural producer</p>
        <p>Discuss how libraries, parks, and neighbourhood events can welcome more people.</p>
        <div class="session-actions">
          <a href="#session-details" data-session="culture">Session details</a>
        </div>
      </article>
    </section>
  </section>

  <section id="venue-information" class="community-note" aria-labelledby="community-heading">
    <svg class="decorative-wave" role="img" aria-label="Purple wave decoration" viewBox="0 0 160 96">
      <path d="M0 38c24-28 53-28 80 0s56 28 80 0v35c-24 28-53 28-80 0S24 45 0 73Z"></path>
    </svg>
    <div>
      <h2 id="community-heading">Meet the community partners</h2>
      <p>Local organizations will host quiet networking tables throughout both days.</p>
    </div>
  </section>

  <dialog id="session-details">
    <div class="dialog-content">
      <p class="eyebrow">Programme details</p>
      <h2 data-dialog-title></h2>
      <p data-dialog-description></p>
      <p><strong>Room:</strong> <span data-dialog-room></span></p>
      <button type="button" data-close-dialog>Close session details</button>
    </div>
  </dialog>
</main>

<script>
  const sessions: Record<string, { title: string; description: string; room: string }> = {
    keynote: {
      title: 'Designing public spaces with communities',
      description: 'The keynote includes a presentation followed by audience questions.',
      room: 'Main hall',
    },
    'data-stories': {
      title: 'Making neighbourhood data understandable',
      description: 'This workshop uses printed examples and a facilitated group activity.',
      room: 'Workshop room 2',
    },
    culture: {
      title: 'Accessible culture in everyday places',
      description: 'The discussion includes short contributions from three community partners.',
      room: 'Community room',
    },
  };

  const dialog = document.querySelector('#session-details');
  const programmeHeading = document.querySelector('#programme-heading');
  const title = dialog?.querySelector('[data-dialog-title]');
  const description = dialog?.querySelector('[data-dialog-description]');
  const room = dialog?.querySelector('[data-dialog-room]');
  const closeButton = dialog?.querySelector('[data-close-dialog]');

  document.querySelectorAll('[data-session]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const key = link.getAttribute('data-session');
      const session = key ? sessions[key] : undefined;
      if (!(dialog instanceof HTMLDialogElement) || !session) return;
      if (title) title.textContent = session.title;
      if (description) description.textContent = session.description;
      if (room) room.textContent = session.room;
      dialog.showModal();
    });
  });

  document.querySelectorAll('[data-schedule]').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.getAttribute('data-schedule');
      const status = key ? document.querySelector(`[data-schedule-status="${key}"]`) : null;
      button.classList.toggle('selected');
      if (status) status.textContent = button.classList.contains('selected') ? 'Added to schedule' : 'Removed from schedule';
    });
  });

  closeButton?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });

  dialog?.addEventListener('keydown', (event) => {
    if (event instanceof KeyboardEvent && event.key === 'Tab' && closeButton instanceof HTMLElement) {
      event.preventDefault();
      closeButton.focus();
    }
  });

  dialog?.addEventListener('close', () => {
    if (programmeHeading instanceof HTMLElement) programmeHeading.focus();
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .conference-shell { max-width: 68rem; margin: 0 auto; padding: 1.5rem; }
  .return-link, a { color: #033573; text-underline-offset: 0.2em; }
  .conference-header, .venue { display: grid; grid-template-columns: minmax(0, 1fr) minmax(12rem, 24rem); gap: 2rem; align-items: center; margin-block: 2rem; }
  .conference-header { padding: 2rem; background: #f5f0ff; border: 2px solid #d8b9f1; }
  .eyebrow, .session-time { margin: 0 0 0.5rem; font-weight: 700; }
  h1, h2, h3, h4, h5 { color: #333; line-height: 1.2; }
  h1 { margin-block: 0.25rem 1rem; font-size: clamp(2.25rem, 7vw, 4rem); }
  h2 { margin-top: 2.5rem; font-size: 2rem; }
  h3 { margin-top: 2rem; font-size: 1.6rem; }
  h4, h5 { margin-block: 0.25rem 1rem; font-size: 1.3rem; }
  .header-mark { width: min(100%, 12rem); justify-self: center; fill: none; stroke: #46037e; stroke-width: 8; }
  .venue img { width: 100%; height: auto; border-radius: 0.25rem; }
  .venue-link { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; }
  .venue-link svg { width: 1.5rem; fill: currentColor; }
  .programme-day { margin-block: 2rem; }
  .session-card { margin-block: 1rem; padding: 1.25rem; border: 2px solid #bbc9f7; }
  .speaker { display: flex; gap: 1rem; align-items: center; }
  .speaker img { width: 7rem; height: 7rem; object-fit: cover; border-radius: 50%; }
  .session-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
  button { padding: 0.65rem 1rem; border: 4px solid transparent; border-radius: 0.25rem; background: #033573; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { border-color: #033573; background: transparent; color: #033573; }
  button svg { width: 1.5rem; height: 1.5rem; fill: currentColor; vertical-align: middle; }
  .schedule-button { width: 3.5rem; height: 3.5rem; padding: 0.75rem; }
  .schedule-status { font-weight: 700; }
  .community-note { display: flex; gap: 1.5rem; align-items: center; margin-block: 3rem; padding: 1.25rem; background: #f5f0ff; }
  .community-note img { width: 8rem; height: 6rem; object-fit: cover; }
  .decorative-wave { width: 8rem; flex: 0 0 auto; fill: #46037e; }
  .community-note h2 { margin-top: 0; }
  dialog { width: min(36rem, calc(100% - 2rem)); padding: 0; border: 4px solid #46037e; background: #fafafa; color: #4d4d4d; }
  dialog::backdrop { background: rgb(1 0 23 / 75%); }
  .dialog-content { padding: 1.5rem; }
  .dialog-content h2 { margin-top: 0.25rem; }
  a:focus, button:focus { outline: 2px solid #000; outline-offset: 4px; box-shadow: 0 0 0 2px #fff; }
  #programme-heading:focus { outline: none; }

  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2, :global(.dark) h3, :global(.dark) h4, :global(.dark) h5 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) .conference-header, :global(.dark) .community-note { background: #070038; border-color: #46037e; }
  :global(.dark) .header-mark { stroke: #ade5f8; }
  :global(.dark) .decorative-wave { fill: #ade5f8; }
  :global(.dark) .session-card { border-color: #18399a; }
  :global(.dark) button { background: #ade5f8; color: #000; }
  :global(.dark) button:hover { border-color: #ade5f8; background: transparent; color: #ade5f8; }
  :global(.dark) dialog { background: #010017; color: #ababab; border-color: #18399a; }
  :global(.dark) a:focus, :global(.dark) button:focus { outline-color: #fff; box-shadow: 0 0 0 2px #010017; }

  @media (max-width: 42rem) {
    .conference-shell { padding: 1rem; }
    .conference-header, .venue { grid-template-columns: 1fr; padding: 1rem; }
    .header-mark { width: 7rem; }
    .speaker, .community-note { align-items: flex-start; flex-direction: column; }
  }
</style>
