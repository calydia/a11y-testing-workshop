<main class="fixture-shell">
  <a href="/exercises/testing-controls-in-a-community-events-finder/">Return to the exercise</a>
  <header>
    <h1>Find community events</h1>
    <p>Filter upcoming events, choose how to view them, and save activities that interest you.</p>
  </header>

  <button id="filter-toggle" type="button" aria-expanded="false" aria-controls="event-filters">Show filters</button>
  <section id="event-filters" hidden aria-labelledby="filter-heading">
    <h2 id="filter-heading">Filter events</h2>
    <fieldset>
      <legend>Categories</legend>
      <label><input type="checkbox" name="category" value="learning" /> Learning</label>
      <label><input type="checkbox" name="category" value="outdoors" /> Outdoors</label>
      <label><input type="checkbox" name="category" value="social" /> Social</label>
    </fieldset>
    <fieldset>
      <legend>Results view</legend>
      <label><input type="radio" name="view" value="list" checked /> List</label>
      <label><input type="radio" name="view" value="compact" /> Compact</label>
    </fieldset>
    <button id="clear-filters" type="button">Clear filters</button>
  </section>

  <p id="result-count">3 events found</p>
  <section class="event-grid" aria-labelledby="results-heading">
    <h2 id="results-heading" class="visually-hidden">Event results</h2>
    <article data-category="learning">
      <h3>Riverside repair café</h3>
      <p>18 September at Riverside Community Centre</p>
      <p>Learn practical repair skills with local volunteers.</p>
      <div class="actions">
        <button id="repair-details" type="button">View event details</button>
        <button id="repair-save" type="button" role="switch" aria-checked="false">Save repair café</button>
      </div>
      <p id="repair-cafe-details" tabindex="-1">Bring one small household item that you can carry safely.</p>
    </article>

    <article data-category="outdoors">
      <h3>Neighbourhood gardening workshop</h3>
      <p>21 September at Harbor Community Garden</p>
      <p>Plan an autumn garden and exchange seeds with neighbours.</p>
      <div class="actions">
        <a href="#garden-details">View event details</a>
        <button id="garden-save" type="button" aria-label="Bookmark item">Save event</button>
      </div>
      <p id="garden-details">Tools and seeds are provided.</p>
    </article>

    <article data-category="social">
      <h3>Community storytelling evening</h3>
      <p>25 September at Eastside Library</p>
      <p>Share a short local story or listen to neighbours tell theirs.</p>
      <button id="share-event" type="button">Copy event information</button>
    </article>
  </section>
</main>

<script>
  const filterToggle = document.querySelector<HTMLButtonElement>('#filter-toggle');
  const filters = document.querySelector<HTMLElement>('#event-filters');
  const resultCount = document.querySelector<HTMLElement>('#result-count');
  const eventCards = [...document.querySelectorAll<HTMLElement>('[data-category]')];
  const categoryInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="category"]')];
  const viewInputs = [...document.querySelectorAll<HTMLInputElement>('input[name="view"]')];

  filterToggle?.addEventListener('click', () => {
    if (!filters) return;
    filters.hidden = !filters.hidden;
    filterToggle.textContent = filters.hidden ? 'Show filters' : 'Hide filters';
  });

  const updateResults = () => {
    const selected = categoryInputs.filter((input) => input.checked).map((input) => input.value);
    eventCards.forEach((card) => {
      card.hidden = selected.length > 0 && !selected.includes(card.dataset.category ?? '');
    });
    const visibleCount = eventCards.filter((card) => !card.hidden).length;
    if (resultCount) resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'event' : 'events'} found`;
  };
  categoryInputs.forEach((input) => input.addEventListener('change', updateResults));

  document.querySelector('#clear-filters')?.addEventListener('click', () => {
    categoryInputs.forEach((input) => { input.checked = false; });
    updateResults();
  });

  viewInputs.forEach((input) => input.addEventListener('change', () => {
    document.querySelector('.event-grid')?.classList.toggle('compact', input.value === 'compact' && input.checked);
  }));

  document.querySelector('#repair-details')?.addEventListener('click', () => {
    window.location.hash = 'repair-cafe-details';
    document.querySelector<HTMLElement>('#repair-cafe-details')?.focus();
  });

  const repairSave = document.querySelector<HTMLButtonElement>('#repair-save');
  const toggleSaved = () => {
    if (!repairSave) return;
    const saved = repairSave.dataset.saved === 'true';
    repairSave.dataset.saved = String(!saved);
    repairSave.textContent = saved ? 'Save repair café' : 'Repair café saved';
  };
  repairSave?.addEventListener('click', toggleSaved);
  repairSave?.addEventListener('keydown', (event) => {
    if (event.key === ' ') {
      event.preventDefault();
      toggleSaved();
    }
  });

  document.querySelector('#garden-save')?.addEventListener('click', (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.textContent = button.textContent === 'Save event' ? 'Event saved' : 'Save event';
  });
  document.querySelector('#share-event')?.addEventListener('click', (event) => {
    (event.currentTarget as HTMLButtonElement).textContent = 'Event information copied';
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .fixture-shell { max-width: 58rem; margin: 0 auto; padding: 1.5rem; }
  h1 { margin-block: 1.5rem .75rem; color: #333; font-size: clamp(2rem, 8vw, 3rem); line-height: 1.1; }
  h2 { margin-block: 2rem .75rem; color: #333; font-size: 1.75rem; }
  h3 { margin-block: 0 .75rem; color: #333; font-size: 1.35rem; }
  p { margin-block: 0 1rem; }
  a { color: #033573; text-underline-offset: .2em; }
  a:hover { text-decoration-thickness: .15em; }
  button { min-height: 2.75rem; padding: .55rem .85rem; border: 3px solid #033573; border-radius: .2rem; background: #033573; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { background: transparent; color: #033573; }
  a:focus, button:focus, input:focus { outline: 2px solid #000; outline-offset: 4px; box-shadow: 0 0 0 2px #fff; }
  #event-filters { margin-block: 1.5rem; padding: 1.25rem; border: 2px solid #bbc9f7; }
  #event-filters h2 { margin-top: 0; }
  fieldset { display: flex; flex-wrap: wrap; gap: .75rem 1.25rem; margin-block: 1rem; padding: 1rem; border: 2px solid #bbc9f7; }
  legend { padding-inline: .25rem; font-weight: 700; }
  label { display: flex; align-items: center; gap: .5rem; }
  input { width: 1.25rem; height: 1.25rem; }
  #result-count { margin-top: 2rem; font-weight: 700; }
  .event-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .event-grid.compact { grid-template-columns: 1fr; }
  article { padding: 1.25rem; border: 2px solid #bbc9f7; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-block: 1rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  [hidden] { display: none; }
  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2, :global(.dark) h3 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) button { border-color: #ade5f8; background: #ade5f8; color: #010017; }
  :global(.dark) button:hover { background: transparent; color: #ade5f8; }
  :global(.dark) a:focus, :global(.dark) button:focus, :global(.dark) input:focus { outline-color: #fff; box-shadow: 0 0 0 2px #010017; }
  :global(.dark) #event-filters, :global(.dark) fieldset, :global(.dark) article { border-color: #18399a; }
  @media (max-width: 48rem) { .fixture-shell { padding: 1rem; } .event-grid { grid-template-columns: 1fr; } article { padding: 1rem; } }
</style>
