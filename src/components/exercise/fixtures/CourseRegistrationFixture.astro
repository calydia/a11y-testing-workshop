<main class="fixture-shell">
  <a href="/exercises/testing-a-community-course-registration-form/">Return to the exercise</a>
  <h1>Register for a community course</h1>
  <p>Choose how you would like to attend and provide the details needed to reserve your place.</p>

  <form id="course-registration" class="registration-card" novalidate data-form-finding="unassociated-inline-errors">
    <p>Fields marked with <span aria-hidden="true">*</span> are required.</p>

    <div id="error-summary" class="message error-summary" hidden data-form-finding="invalid-focus-unchanged">
      <h2>There is a problem</h2>
      <p>Review the fields listed below.</p>
      <ul></ul>
    </div>

    <div class="field">
      <label for="participant-name">Full name <span aria-hidden="true">*</span></label>
      <input id="registrant-name" name="name" type="text" autocomplete="name" required data-form-finding="disconnected-label" />
      <div class="error-slot" data-error-for="registrant-name"></div>
    </div>

    <div class="field">
      <label for="email">Email address <span aria-hidden="true">*</span></label>
      <p id="email-format" class="instruction" data-form-finding="disconnected-format-instruction">Use the format name@example.com.</p>
      <input id="email" name="email" type="email" autocomplete="email" required />
      <div class="error-slot" data-error-for="email"></div>
    </div>

    <div class="field">
      <label for="course">Course</label>
      <select id="course" name="course">
        <option>Accessible documents</option>
        <option>Introduction to web accessibility</option>
        <option>Inclusive event planning</option>
      </select>
    </div>

    <div class="field">
      <p class="group-prompt">How would you like to attend? <span aria-hidden="true">*</span></p>
      <div class="choice-group" role="group" data-form-finding="unnamed-format-group">
        <label><input type="radio" name="attendance" value="in-person" required /> In person</label>
        <label><input type="radio" name="attendance" value="online" /> Online</label>
      </div>
      <div class="error-slot" data-error-for="attendance"></div>
    </div>

    <div class="field">
      <label class="checkbox-label">
        <input id="updates" name="updates" type="checkbox" />
        Email me about future community courses
      </label>
    </div>

    <div class="field">
      <label class="checkbox-label">
        <input id="agreement" name="agreement" type="checkbox" required />
        I confirm that the registration details are correct <span aria-hidden="true">*</span>
      </label>
      <div class="error-slot" data-error-for="agreement"></div>
    </div>

    <button type="submit">Register for course</button>
  </form>

  <section id="registration-confirmation" class="message confirmation" hidden data-form-finding="unannounced-success">
    <h2>Registration received</h2>
    <p>Your place has been reserved. Check your email for course details.</p>
  </section>
</main>

<script>
  const form = document.querySelector('#course-registration');
  const summary = document.querySelector('#error-summary');
  const summaryList = summary?.querySelector('ul');
  const confirmation = document.querySelector('#registration-confirmation');

  const errorDefinitions = [
    { key: 'registrant-name', field: document.querySelector('#registrant-name'), message: 'Enter your full name.' },
    { key: 'email', field: document.querySelector('#email'), message: 'Enter an email address in the format name@example.com.' },
    { key: 'attendance', field: document.querySelector('input[name="attendance"]'), message: 'Choose how you would like to attend.' },
    { key: 'agreement', field: document.querySelector('#agreement'), message: 'Confirm that the registration details are correct.' },
  ];

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    document.querySelectorAll('.error-slot').forEach((slot) => slot.replaceChildren());
    summaryList?.replaceChildren();
    confirmation?.setAttribute('hidden', '');

    const errors = errorDefinitions.filter(({ key, field }) => {
      if (!(field instanceof HTMLInputElement)) return false;
      if (key === 'attendance') return !document.querySelector('input[name="attendance"]:checked');
      return !field.validity.valid;
    });

    if (errors.length > 0) {
      errors.forEach(({ key, message }) => {
        const item = document.createElement('li');
        item.textContent = message;
        summaryList?.append(item);

        const inlineError = document.createElement('p');
        inlineError.className = 'field-error';
        inlineError.id = `${key}-error`;
        inlineError.textContent = message;
        document.querySelector(`[data-error-for="${key}"]`)?.append(inlineError);
      });
      summary?.removeAttribute('hidden');
      return;
    }

    summary?.setAttribute('hidden', '');
    confirmation?.removeAttribute('hidden');
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .fixture-shell { max-width: 46rem; margin: 0 auto; padding: 1.5rem; }
  h1 { margin-block: 1.5rem 0.75rem; color: #333; font-size: clamp(2rem, 8vw, 3rem); line-height: 1.1; }
  h2 { margin-block: 0 0.75rem; color: #333; }
  p { margin-block: 0 1rem; }
  a { color: #033573; text-underline-offset: 0.2em; }
  .registration-card { margin-block: 1.5rem; padding: 1.25rem; border: 2px solid #bbc9f7; }
  .field { margin-block: 1.5rem; }
  .field > label:not(.checkbox-label), .group-prompt { display: block; margin-bottom: 0.4rem; font-weight: 700; }
  .instruction { margin-bottom: 0.4rem; }
  input[type='text'], input[type='email'], select { width: 100%; padding: 0.7rem; border: 2px solid #7a89ad; border-radius: 0.25rem; background: #fff; color: #18151f; font: inherit; }
  .choice-group { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  .choice-group label, .checkbox-label { display: flex; align-items: start; gap: 0.55rem; }
  input[type='radio'], input[type='checkbox'] { width: 1.25rem; height: 1.25rem; margin-top: 0.2rem; }
  button { width: fit-content; padding: 0.7rem 1rem; border: 4px solid transparent; border-radius: 0.25rem; background: #033573; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { border-color: #033573; background: transparent; color: #033573; }
  .message { margin-block: 1.5rem; padding: 1rem; border: 3px solid #8b1d1d; }
  .error-summary, :global(.field-error) { color: #7b1717; }
  :global(.field-error) { margin-block: 0.4rem 0; font-weight: 700; }
  .confirmation { border-color: #236627; }
  a:focus, input:focus, select:focus, button:focus { outline: 3px solid #000; outline-offset: 4px; box-shadow: 0 0 0 2px #fff; }

  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) .registration-card { border-color: #18399a; }
  :global(.dark) .error-summary, :global(.dark .field-error) { color: #ffb5b5; }
  :global(.dark) .message { border-color: #ffb5b5; }
  :global(.dark) .confirmation { border-color: #8ed391; }
  :global(.dark) button { background: #ade5f8; color: #000; }
  :global(.dark) button:hover { border-color: #ade5f8; background: transparent; color: #ade5f8; }
  :global(.dark) a:focus, :global(.dark) input:focus, :global(.dark) select:focus, :global(.dark) button:focus { outline-color: #fff; box-shadow: 0 0 0 2px #010017; }

  @media (max-width: 34rem) {
    .fixture-shell { padding: 1rem; }
    .registration-card { padding: 1rem; }
    .choice-group { flex-direction: column; gap: 0.75rem; }
  }
</style>
