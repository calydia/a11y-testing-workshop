<main class="fixture-shell">
  <a href="/exercises/testing-an-appointment-booking-at-high-zoom/">Return to the exercise</a>
  <h1>Review your appointment</h1>
  <p>Review the booking details and confirm the appointment.</p>

  <div class="booking-panel" data-zoom-finding="fixed-panel">
    <section aria-labelledby="appointment-heading" class="appointment-card" data-zoom-finding="fixed-height-card">
      <h2 id="appointment-heading">Accessibility consultation</h2>
      <p>Tuesday, 18 August at 14:30</p>
      <p>Remote meeting with Morgan Lee. Joining instructions will be sent to your contact address before the appointment.</p>
      <a href="#contact-heading">Review contact information</a>
    </section>

    <section aria-labelledby="reference-heading">
      <h2 id="reference-heading">Confirmation reference</h2>
      <code data-zoom-finding="unbreakable-reference">APPOINTMENT-2026-08-18-ACCESSIBILITY-CONSULTATION-847291</code>
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact information</h2>
      <p>learner@example.com</p>
      <button id="edit-contact" type="button">Edit contact information</button>
    </section>

    <section class="final-check" aria-labelledby="check-heading" data-obscured-target>
      <h2 id="check-heading">Before you confirm</h2>
      <p>Check that the date, time, service, and contact information are correct.</p>
    </section>
  </div>

  <div class="fixed-actions" data-zoom-finding="fixed-action-bar">
    <button id="confirm-appointment" type="button">Confirm appointment</button>
    <p class="status-message" role="status" aria-live="polite"></p>
  </div>
</main>

<script>
  const confirmButton = document.querySelector('#confirm-appointment');
  const statusMessage = document.querySelector('.status-message');
  confirmButton?.addEventListener('click', () => {
    if (statusMessage) statusMessage.textContent = 'Appointment confirmed.';
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .fixture-shell { max-width: 52rem; margin: 0 auto; padding: 1.5rem 1.5rem 4rem; }
  h1 { margin-block: 1.5rem 0.75rem; color: #333; font-size: clamp(2rem, 8vw, 3rem); line-height: 1.1; }
  h2 { margin-block: 0 0.75rem; color: #333; }
  p { margin-block: 0 1rem; }
  a { color: #033573; text-underline-offset: 0.2em; }
  .booking-panel { width: 44rem; display: grid; gap: 1.25rem; }
  .booking-panel > section { padding: 1.25rem; border: 2px solid #bbc9f7; }
  .appointment-card { height: 250px; overflow: hidden; }
  code { display: block; width: 24rem; overflow: hidden; white-space: nowrap; font-size: 1rem; }
  button { padding: 0.7rem 1rem; border: 4px solid transparent; border-radius: 0.25rem; background: #033573; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { border-color: #033573; background: transparent; color: #033573; }
  a:focus, button:focus { outline: 2px solid #000; outline-offset: 4px; box-shadow: 0 0 0 2px #fff; }
  .fixed-actions { display: flex; align-items: center; gap: 1rem; margin-top: 1.25rem; min-height: 5rem; padding: 0.75rem 1.5rem; border-top: 2px solid #bbc9f7; background: #fafafa; }
  .status-message { min-height: 1.75rem; margin: 0; font-weight: 700; }

  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) .booking-panel > section, :global(.dark) .fixed-actions { border-color: #18399a; }
  :global(.dark) .fixed-actions { background: #010017; }
  :global(.dark) button { background: #ade5f8; color: #000; }
  :global(.dark) button:hover { border-color: #ade5f8; background: transparent; color: #ade5f8; }
  :global(.dark) a:focus, :global(.dark) button:focus { outline-color: #fff; box-shadow: 0 0 0 2px #010017; }

  @media (max-width: 30rem) {
    .fixed-actions { position: fixed; inset-inline: 0; bottom: 0; margin-top: 0; }
  }
</style>
