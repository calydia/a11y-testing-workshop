<main class="fixture-shell">
  <a href="/exercises/comparing-automated-and-manual-findings/">Return to the exercise</a>
  <h1>Inclusive product conference</h1>
  <p>Choose a session and register for event updates.</p>

  <section class="event-card" aria-labelledby="saved-heading">
    <h2 id="saved-heading">Saved session</h2>
    <div class="saved-row">
      <span>Designing inclusive forms</span>
      <button id="remove-saved-session" data-automated-finding="unnamed-button" type="button"><span aria-hidden="true">×</span></button>
    </div>
  </section>

  <section class="event-card" aria-labelledby="sessions-heading">
    <h2 id="sessions-heading">Available sessions</h2>
    <div id="choose-session" class="session-control" data-automated-finding="pointer-only-session">Choose this session</div>

    <div class="session-links" data-automated-finding="ambiguous-links">
      <article id="inclusive-design-session">
        <h3>Inclusive design systems</h3>
        <p>Build reusable patterns that support a wider range of people.</p>
        <a href="#inclusive-design-session">Read more</a>
      </article>
      <article id="accessible-content-session">
        <h3>Accessible content workflows</h3>
        <p>Include accessibility checks throughout writing and publishing.</p>
        <a href="#accessible-content-session">Read more</a>
      </article>
    </div>
  </section>

  <form id="registration-form" class="event-card">
    <h2>Registration updates</h2>
    <p>Email address</p>
    <input id="registration-email" data-automated-finding="unlabelled-email" name="email" type="email" />
    <p class="registration-helper" data-automated-finding="low-contrast-helper">We will send schedule changes and joining instructions.</p>
    <button type="submit">Register for event</button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</main>

<script>
  const sessionControl = document.querySelector('#choose-session');
  const form = document.querySelector('#registration-form');
  const status = document.querySelector('.form-status');
  sessionControl?.addEventListener('click', () => {
    sessionControl.textContent = 'Session chosen';
  });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (status) status.textContent = 'Registration submitted.';
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .fixture-shell { max-width: 46rem; margin: 0 auto; padding: 1.5rem; }
  h1 { margin-block: 1.5rem 0.75rem; color: #333; font-size: clamp(2rem, 8vw, 3rem); line-height: 1.1; }
  h2, h3 { color: #333; }
  h2 { margin-block: 0 0.75rem; }
  h3 { margin-block: 0 0.5rem; }
  p { margin-block: 0 1rem; }
  a { color: #033573; text-underline-offset: 0.2em; }
  .event-card { margin-block: 1.5rem; padding: 1.25rem; border: 2px solid #bbc9f7; }
  .saved-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .session-control, button { width: fit-content; padding: 0.7rem 1rem; border: 4px solid transparent; border-radius: 0.25rem; background: #033573; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover, .session-control:hover { border-color: #033573; background: transparent; color: #033573; }
  #remove-saved-session { min-width: 3rem; }
  .session-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }
  .session-links article { padding: 1rem; border: 2px solid #bbc9f7; }
  input { width: 100%; padding: 0.7rem; border: 2px solid #bbc9f7; border-radius: 0.25rem; font: inherit; }
  .registration-helper { margin-block: 0.5rem 1rem; color: #b2b2b2; }
  .form-status { min-height: 1.75rem; margin-block: 1rem 0; font-weight: 700; }
  a:focus, input:focus, button:focus { outline: 2px solid #000; outline-offset: 4px; box-shadow: 0 0 0 2px #fff; }

  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2, :global(.dark) h3 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) .event-card, :global(.dark) .session-links article, :global(.dark) input { border-color: #18399a; }
  :global(.dark) input { background: #fff; color: #18151f; }
  :global(.dark) button, :global(.dark) .session-control { background: #ade5f8; color: #000; }
  :global(.dark) button:hover, :global(.dark) .session-control:hover { border-color: #ade5f8; background: transparent; color: #ade5f8; }
  :global(.dark) .registration-helper { color: #40404a; }
  :global(.dark) a:focus, :global(.dark) input:focus, :global(.dark) button:focus { outline-color: #fff; box-shadow: 0 0 0 2px #010017; }

  @media (max-width: 34rem) {
    .fixture-shell { padding: 1rem; }
    .event-card { padding: 1rem; }
    .session-links { grid-template-columns: 1fr; }
  }
</style>
