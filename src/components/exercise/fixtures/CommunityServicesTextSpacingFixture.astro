<main class="fixture-shell">
  <a class="return-link" href="/exercises/testing-text-spacing-on-a-community-services-page/">Return to the exercise</a>

  <header>
    <p class="eyebrow">Riverside Community Centre</p>
    <h1>Find community support</h1>
    <p>Explore local advice, practical help, and welcoming activities for residents.</p>
  </header>

  <section class="test-controls" aria-labelledby="spacing-heading">
    <h2 id="spacing-heading">Text-spacing test</h2>
    <p>Apply the complete test condition, inspect the page, and reset it to compare results.</p>
    <button id="spacing-toggle" type="button" aria-pressed="false">Apply test text spacing</button>
  </section>

  <nav aria-label="Community services">
    <ul class="service-navigation">
      <li><a class="fixed-navigation-link" href="#family-support">Housing advice appointments</a></li>
      <li><a href="#digital-support">Digital support drop-in</a></li>
      <li><a href="#opening-information">Opening information</a></li>
    </ul>
  </nav>

  <section class="intro-panel" aria-labelledby="welcome-heading">
    <h2 id="welcome-heading">Support close to home</h2>
    <p>Our advisers can help you understand local services, complete applications, and find the right community contact. You do not need to know which team you need before getting in touch.</p>
  </section>

  <aside class="important-notice" aria-labelledby="notice-heading">
    <h2 id="notice-heading">Important service notice</h2>
    <p>Housing advisers are available by telephone on Tuesday morning and in person on Thursday afternoon. Bring any letters you would like help understanding.</p>
  </aside>

  <section class="urgent-support" aria-labelledby="urgent-support-heading">
    <h2 id="urgent-support-heading">Urgent support</h2>
    <p class="resistant-spacing">If you need help today, call reception before 15:30 so the team can connect you with the appropriate local service.</p>
  </section>

  <section class="services" aria-labelledby="services-heading">
    <h2 id="services-heading">Available support</h2>
    <div class="service-grid">
      <article id="family-support" class="service-card fixed-service-card">
        <h3>Family support appointments</h3>
        <p>Talk privately with an adviser about childcare, benefits, or finding local activities.</p>
        <a href="#contact-actions">Ask about family support</a>
      </article>

      <article id="digital-support" class="service-card flexible-service-card">
        <h3>Digital support drop-in</h3>
        <p>Bring your phone, tablet, or laptop and get help using essential online services.</p>
        <a href="#contact-actions">Ask about digital support</a>
      </article>
    </div>
  </section>

  <section id="opening-information" class="opening-information" aria-labelledby="opening-heading">
    <h2 id="opening-heading">Opening information</h2>
    <p>Reception is open Monday to Friday from 09:00 to 16:00. Quiet appointments are available on request.</p>
  </section>

  <section id="contact-actions" class="contact-actions" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Contact the centre</h2>
    <p>Choose the contact option that works best for you.</p>
    <div class="button-row">
      <button class="fixed-contact-button" type="button">Contact community support</button>
      <button type="button">Request a call back</button>
    </div>
  </section>
</main>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#spacing-toggle');
  const styleId = 'text-spacing-test-styles';
  const overrideStyles = `
    * {
      line-height: 1.5 !important;
      letter-spacing: 0.12em !important;
      word-spacing: 0.16em !important;
    }
    p {
      margin-block-end: 2em !important;
    }
  `;

  toggle?.addEventListener('click', () => {
    const active = toggle.getAttribute('aria-pressed') === 'true';
    document.getElementById(styleId)?.remove();

    if (active) {
      toggle.setAttribute('aria-pressed', 'false');
      toggle.textContent = 'Apply test text spacing';
      return;
    }

    const style = document.createElement('style');
    style.id = styleId;
    style.textContent = overrideStyles;
    document.head.append(style);
    toggle.setAttribute('aria-pressed', 'true');
    toggle.textContent = 'Reset text spacing';
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .fixture-shell { max-width: 64rem; margin: 0 auto; padding: 1.5rem; }
  header { margin-block: 2rem; }
  .eyebrow { margin: 0; font-weight: 700; }
  h1 { margin-block: .25rem .75rem; color: #333; font-size: clamp(2rem, 8vw, 3.5rem); line-height: 1.1; }
  h2 { margin-block: 0 .75rem; color: #333; font-size: 1.75rem; line-height: 1.2; }
  h3 { margin-block: 0 .65rem; color: #333; font-size: 1.35rem; line-height: 1.2; }
  p { margin-block: 0 1rem; }
  a { color: #033573; text-underline-offset: .2em; }
  a:hover { text-decoration-thickness: .15em; }
  button { min-height: 2.75rem; padding: .6rem 1rem; border: 3px solid #033573; border-radius: .2rem; background: #033573; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  button:hover { background: transparent; color: #033573; }
  a:focus, button:focus { outline: 2px solid #000; outline-offset: 4px; box-shadow: 0 0 0 2px #fff; }
  .test-controls, .intro-panel, .important-notice, .urgent-support, .opening-information, .contact-actions { margin-block: 1.5rem; padding: 1.25rem; border: 2px solid #bbc9f7; }
  .test-controls { background: #eef1fb; }
  .service-navigation { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 1.5rem; padding: 0; list-style: none; }
  .service-navigation a { display: block; padding: .65rem .8rem; border: 2px solid #6f81b8; }
  .fixed-navigation-link { width: 18.5rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .intro-panel { height: 12.5rem; overflow: hidden; }
  .important-notice { background: #fff5d9; border-color: #c58500; }
  .important-notice p { display: -webkit-box; max-width: 40rem; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .urgent-support { border-inline-start-width: .5rem; }
  .urgent-support .resistant-spacing { margin-block-end: .5rem !important; line-height: 1.15 !important; letter-spacing: 0 !important; word-spacing: 0 !important; }
  .service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .service-card { padding: 1.25rem; border: 2px solid #bbc9f7; }
  .fixed-service-card { position: relative; height: 13.5rem; overflow: hidden; }
  .fixed-service-card h3 { position: absolute; inset: 1.25rem auto auto 1.25rem; width: min(17rem, calc(100% - 2.5rem)); }
  .fixed-service-card p { position: absolute; inset: 4.5rem 1.25rem auto; }
  .fixed-service-card a { position: absolute; inset: auto 1.25rem 1.25rem; }
  .button-row { display: flex; flex-wrap: wrap; gap: 1rem; }
  .fixed-contact-button { width: 17.5rem; height: 3.5rem; overflow: hidden; white-space: nowrap; }
  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2, :global(.dark) h3 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) button { border-color: #ade5f8; background: #ade5f8; color: #010017; }
  :global(.dark) button:hover { background: transparent; color: #ade5f8; }
  :global(.dark) a:focus, :global(.dark) button:focus { outline-color: #fff; box-shadow: 0 0 0 2px #010017; }
  :global(.dark) .test-controls, :global(.dark) .intro-panel, :global(.dark) .urgent-support, :global(.dark) .opening-information, :global(.dark) .contact-actions, :global(.dark) .service-card { border-color: #18399a; }
  :global(.dark) .test-controls { background: #100842; }
  :global(.dark) .important-notice { background: #332400; border-color: #d9a82f; }
  @media (max-width: 42rem) {
