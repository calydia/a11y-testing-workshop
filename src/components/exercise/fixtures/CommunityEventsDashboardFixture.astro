<main class="fixture-shell">
  <a href="/exercises/reviewing-icons-and-svgs-in-a-community-events-dashboard/">Return to the exercise</a>
  <header>
    <h1>My community events</h1>
    <p>Review saved events, check availability, and manage your personal schedule.</p>
  </header>

  <section class="summary" aria-labelledby="summary-heading">
    <div>
      <h2 id="summary-heading">Your event summary</h2>
      <p>Updates reflect the events currently shown in this practice dashboard.</p>
    </div>
    <svg data-summary-graphic role="img" aria-label="Three saved events" class="summary-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 13h30v26H9zM15 8v10M33 8v10M9 21h30" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
      <circle cx="18" cy="29" r="2.5" fill="currentColor" /><circle cx="30" cy="29" r="2.5" fill="currentColor" />
    </svg>
  </section>

  <section aria-labelledby="saved-events-heading">
    <h2 id="saved-events-heading">Saved events</h2>
    <div class="event-grid">
      <article class="event-card">
        <div class="event-date">
          <svg data-calendar-icon aria-hidden="true" focusable="false" class="small-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 6h16v14H4zM8 3v6M16 3v6M4 10h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span>18 September, 17:30</span>
        </div>
        <h3>Riverside repair café</h3>
        <p>Bring a small household item and learn practical repair skills with local volunteers.</p>
        <p class="availability-row">
          <svg data-event-graphic="availability" role="img" class="small-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M12 7v6M12 17h.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
          </svg>
        </p>
        <div class="actions">
          <button data-event-action="remove" type="button" class="icon-button">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 7h14M9 7V4h6v3M8 7l1 13h6l1-13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <a href="#repair-cafe-details">View event details <svg aria-hidden="true" focusable="false" class="inline-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        </div>
      </article>

      <article class="event-card">
        <div class="event-date"><span>21 September, 14:00</span></div>
        <h3>Neighbourhood gardening workshop</h3>
        <p>Plan an autumn balcony garden and exchange seeds with neighbours.</p>
        <p class="availability-row">
          <svg data-event-graphic="online" role="img" aria-label="Icon" class="small-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="5" width="18" height="13" rx="1" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M8 21h8M12 18v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </p>
        <div class="actions">
          <button data-event-action="add" type="button" class="icon-button" aria-label="Add neighbourhood gardening workshop to saved events">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </button>
          <button data-event-action="save" type="button">
            <svg role="img" aria-label="Star" focusable="false" class="inline-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></svg>
            Save event
          </button>
        </div>
      </article>

      <article class="event-card">
        <div class="event-date"><span>25 September, 18:00</span></div>
        <h3>Community storytelling evening</h3>
        <p>Share a short local story or listen to neighbours tell theirs.</p>
        <div class="actions">
          <button data-event-action="download" type="button">
            <svg role="img" aria-label="Download" focusable="false" class="inline-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Download schedule
          </button>
        </div>
      </article>
    </div>
  </section>

  <aside class="note" aria-label="Dashboard note">
    <svg aria-hidden="true" focusable="false" class="small-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" /><path d="M12 11v6M12 7h.01" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" /></svg>
    <p id="repair-cafe-details">Event information and saved-event changes are for practice only.</p>
  </aside>
  <p id="action-status" class="status" role="status" aria-live="polite"></p>
</main>

<script>
  const messages: Record<string, string> = {
    remove: 'Repair café removed from this practice dashboard.',
    add: 'Gardening workshop added to this practice dashboard.',
    save: 'Gardening workshop saved.',
    download: 'Practice schedule download selected.',
  };
  document.querySelectorAll('[data-event-action]').forEach((control) => {
    control.addEventListener('click', () => {
      const action = control.getAttribute('data-event-action');
      const status = document.querySelector('#action-status');
      if (status && action && action in messages) status.textContent = messages[action];
    });
  });
</script>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #fafafa; color: #4d4d4d; font-family: 'Atkinson Hyperlegible', Arial, sans-serif; font-size: 1.125rem; line-height: 1.5; }
  .fixture-shell { max-width: 58rem; margin: 0 auto; padding: 1.5rem; }
  h1 { margin-block: 1.5rem 0.75rem; color: #333; font-size: clamp(2rem, 8vw, 3rem); line-height: 1.1; }
  h2 { margin-block: 2.25rem 0.75rem; color: #333; font-size: 1.75rem; }
  h3 { margin-block: 0 0.75rem; color: #333; font-size: 1.35rem; }
  p { margin-block: 0 1rem; }
  a { color: #033573; text-underline-offset: 0.2em; }
  a:hover { text-decoration-thickness: 0.15em; }
  a:focus, button:focus { outline: 2px solid #000; outline-offset: 4px; }
  button { display: inline-flex; align-items: center; gap: .45rem; min-height: 2.75rem; border: 3px solid #033573; background: #033573; color: #fff; padding: .5rem .75rem; font: inherit; font-weight: 700; }
  button:hover { background: transparent; color: #033573; }
  .summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-block: 2rem; padding: 1.25rem; border: 2px solid #bbc9f7; }
  .summary h2 { margin-top: 0; }
  .summary p { margin-bottom: 0; }
  .summary-icon { flex: 0 0 auto; width: 4rem; height: 4rem; color: #54007b; }
  .event-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .event-card { display: flex; flex-direction: column; padding: 1.25rem; border: 2px solid #bbc9f7; }
  .event-date, .availability-row, .actions, .note { display: flex; align-items: center; gap: .5rem; }
  .event-date { font-weight: 700; }
  .actions { flex-wrap: wrap; margin-top: auto; padding-top: .75rem; }
  .small-icon { flex: 0 0 auto; width: 1.75rem; height: 1.75rem; color: #54007b; }
  .inline-icon { width: 1.25rem; height: 1.25rem; vertical-align: middle; }
  .icon-button { justify-content: center; width: 2.9rem; padding: .4rem; }
  .icon-button svg { width: 1.4rem; height: 1.4rem; }
  .note { margin-top: 2rem; padding: 1rem; border-left: 4px solid #18399a; background: #f5f7ff; }
  .note p { margin: 0; }
  .status { min-height: 1.75rem; margin-top: 1rem; font-weight: 700; }

  :global(.dark body) { background: #010017; color: #ababab; }
  :global(.dark) h1, :global(.dark) h2, :global(.dark) h3 { color: #cfcfcf; }
  :global(.dark) a { color: #ade5f8; }
  :global(.dark) a:focus, :global(.dark) button:focus { outline-color: #fff; }
  :global(.dark) button { border-color: #ade5f8; background: #ade5f8; color: #010017; }
  :global(.dark) button:hover { background: transparent; color: #ade5f8; }
  :global(.dark) .summary, :global(.dark) .event-card { border-color: #18399a; }
  :global(.dark) .summary-icon, :global(.dark) .small-icon { color: #ade5f8; }
  :global(.dark) .note { border-color: #ade5f8; background: #070038; }

  @media (max-width: 48rem) {
    .fixture-shell { padding: 1rem; }
    .event-grid { grid-template-columns: 1fr; }
    .event-card { padding: 1rem; }
  }
</style>
