<main class="fixture-shell" id="community-announcement-media">
  <a class="return-link" href="/exercises/testing-a-community-announcement-video/">Return to the exercise</a>

  <header>
    <p class="eyebrow">Riverside Community Centre</p>
    <h1>Open-day announcement</h1>
    <p>Watch the announcement, compare its alternatives, and check the player behavior available in your browser.</p>
  </header>

  <section class="media-panel" aria-labelledby="video-heading">
    <h2 id="video-heading">Community-centre open day</h2>
    <video controls preload="metadata" poster="/media/community-centre-open-day-poster.svg" aria-label="Community-centre open-day announcement">
      <source src="/media/community-centre-open-day.webm" type="video/webm" />
      <track
        default
        kind="captions"
        label="English"
        srclang="en"
        src="/media/community-centre-open-day.en.vtt"
      />
      Your browser does not support the video element.
    </video>
  </section>

  <section class="transcript" aria-labelledby="transcript-heading">
    <h2 id="transcript-heading">Transcript</h2>
    <p><strong>Narrator:</strong> Welcome to Riverside Community Centre's open day this Saturday.</p>
    <p>Meet local groups, try short workshops, and enjoy lunch in the garden.</p>
    <p>Workshops are free, and you do not need to book.</p>
    <p><strong>[Bell rings]</strong></p>
    <p><strong>Alex:</strong> This is Alex from the community team. Visit the welcome desk if you need help during the day.</p>
    <p>Take your time and enjoy everything the open day has to offer. We look forward to seeing you.</p>
  </section>

  <aside class="testing-note" aria-labelledby="testing-note-heading">
    <h2 id="testing-note-heading">About testing this player</h2>
    <p>Native controls, keyboard commands, caption menus, caption presentation, and assistive-technology output vary by browser and operating system. Record the environment you use and describe what you can verify directly.</p>
  </aside>
</main>

<script>
  const video = document.querySelector<HTMLVideoElement>('#community-announcement-media video');
  const normalizeDuration = () => {
    if (!video || Number.isFinite(video.duration)) return;
    const resetPosition = () => {
      if (!Number.isFinite(video.duration)) return;
      video.currentTime = 0;
      video.removeEventListener('durationchange', resetPosition);
      video.removeEventListener('timeupdate', resetPosition);
    };
    video.addEventListener('durationchange', resetPosition);
    video.addEventListener('timeupdate', resetPosition);
    video.currentTime = Number.MAX_SAFE_INTEGER;
  };
  if (video?.readyState && video.readyState >= 1) normalizeDuration();
  else video?.addEventListener('loadedmetadata', normalizeDuration, { once: true });
</script>

