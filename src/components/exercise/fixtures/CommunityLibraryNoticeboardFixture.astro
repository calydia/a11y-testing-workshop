<main class="fixture-shell">
  <a href="/exercises/testing-language-changes-on-a-community-library-noticeboard/">Return to the exercise</a>
  <h1>Community library noticeboard</h1>
  <p>Read upcoming library notices in English, Finnish, and Swedish.</p>

  <section aria-labelledby="upcoming-heading">
    <h2 id="upcoming-heading">Upcoming at the library</h2>
    <div class="notice-grid">
      <article class="notice-card">
        <p class="notice-label">Finnish notice</p>
        <h3>Family reading morning</h3>
        <p data-language-case="finnish-unmarked">Tervetuloa koko perheen lukuaamuun lauantaina kello kymmenen.</p>
        <p><a href="#family-reading-details">View family reading details</a></p>
      </article>

      <article class="notice-card" lang="fi" data-language-case="swedish-as-finnish">
        <p class="notice-label">Swedish notice</p>
        <h3>Digital help</h3>
        <p>Välkommen till bibliotekets digitala handledning på tisdag eftermiddag.</p>
        <p><a href="#digital-help-details">Mer information om digital handledning</a></p>
      </article>

      <article class="notice-card">
        <p class="notice-label">Swedish notice</p>
        <h3>Book discussion</h3>
        <p lang="sv" data-language-case="swedish-link-override">
          Bokdiskussionen börjar klockan arton. <a lang="en" href="#book-discussion-details">Anmäl dig till bokdiskussionen</a>.
        </p>
      </article>

      <article class="notice-card" lang="fi" data-language-case="wide-finnish-scope">
        <p class="notice-label">Finnish notice</p>
        <h3>Writing workshop</h3>
        <p>Kirjoittamisen työpaja järjestetään kirjaston ryhmätilassa.</p>
        <p data-language-content="english-inside-finnish">Places are available for twelve participants.</p>
      </article>

      <article class="notice-card">
        <p class="notice-label">Swedish notice</p>
        <h3>Local history evening</h3>
        <p lang="swedish" data-language-case="invalid-swedish-value">Biblioteket ordnar en kväll om områdets lokala historia.</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="comparison-heading">
    <h2 id="comparison-heading">More library activities</h2>
    <div class="comparison-list">
      <p lang="fi" data-language-comparison="finnish">Kirjastossa järjestetään suomenkielinen satutuokio keskiviikkona.</p>
      <p lang="sv" data-language-comparison="swedish">
        Bibliotekets svenska sagostund ordnas på torsdag. <a href="#story-time-details" data-language-comparison="inherited-link">Läs mer om sagostunden</a>.
      </p>
      <p lang="fi" data-language-comparison="nested-english">
        Ilmoittaudu työpajaan <span lang="en">Creative Coding for Everyone</span> kirjaston neuvonnassa.
      </p>
    </div>
  </section>

  <section class="details" aria-labelledby="details-heading">
    <h2 id="details-heading">Event information</h2>
    <p id="family-reading-details"><strong>Family reading morning:</strong> Meet in the children's section.</p>
    <p id="digital-help-details"><strong>Digital help:</strong> Bring your own device or borrow one at the desk.</p>
    <p id="book-discussion-details"><strong>Book discussion:</strong> Registration closes one day before the event.</p>
    <p id="story-time-details"><strong>Story time:</strong> The session lasts approximately thirty minutes.</p>
  </section>
</main>

