---
import { getFixture } from '../../exercises/fixture-registry';

interface Props { fixtureKey: string }
const { fixtureKey } = Astro.props;
const fixture = getFixture(fixtureKey);
const FixtureComponent = fixture.component;
const fixtureUrl = `/exercise-fixtures/${fixtureKey}/`;
---

{fixture.kind === 'inline' ? (
  <FixtureComponent />
) : (
  <div>
    <p class="mb-4"><a href={fixtureUrl}>Open exercise in a new page</a></p>
    <iframe
      class:list={[
        'w-full border-2 md:min-h-[64rem]',
        fixtureKey === 'automated-event-registration' ? 'min-h-[100rem]' : 'min-h-[80rem]',
      ]}
      src={fixtureUrl}
      title={fixture.title}
    ></iframe>
  </div>
)}
