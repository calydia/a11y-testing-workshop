---
  import { Icon } from 'astro-icon/components';

  const { currentUrl = '/' } = Astro.props;

  const navItems = [
    { href: '/learn/', label: 'Learning paths' },
    { href: '/methods/', label: 'Testing methods' },
    { href: '/exercises/', label: 'Exercises' },
    { href: '/journeys/', label: 'Testing journeys' },
  ];

  const normalizeUrl = (url: string) => url === '/' ? '/' : url.replace(/\/$/, '');
  const normalizedCurrentUrl = normalizeUrl(currentUrl);
  const getCurrentState = (href: string) => {
    const normalizedHref = normalizeUrl(href);

    if (normalizedHref === '/') {
      return normalizedCurrentUrl === '/' ? 'page' : undefined;
    }

    if (normalizedCurrentUrl === normalizedHref) {
      return 'page';
    }

    return undefined;
  };
  const isCurrentSection = (href: string) => {
    const normalizedHref = normalizeUrl(href);
    return normalizedCurrentUrl === normalizedHref || normalizedCurrentUrl.startsWith(`${normalizedHref}/`);
  };
---

<nav id="main-menu-nav" aria-labelledby="main-menu-label" class="text-black dark:text-white py-1 mt-2 nav-bar" aria-label="Main">
  <button id="main-menu-toggle" class="menu-toggle flex items-center gap-2 mt-2 mx-auto text-black border-y-4 border-transparent dark:text-white lg:hidden lg:invisible
  hover:border-y-4 hover:border-lt-purple dark:hover:border-dk-blue-light
  focus:outline focus:outline-2 focus:outline-offset-4 	focus:outline-black dark:focus:outline-white"
    aria-expanded="false" aria-controls="main-menu" aria-haspopup="true">
    <Icon name="bars-3-solid" class="menu-open h-8 w-8" aria-hidden="true" />
    <Icon name="x-mark-solid" class="menu-close h-8 w-8" aria-hidden="true" />
    <span>Menu</span>
  </button>
  <ul id="main-menu" class="text-left mx-auto lg:visible lg:flex lg:flex-wrap lg:justify-center mt-4 p-0 mb-0
    max-lg:absolute max-lg:z-20 lg:w-[90%] max-lg:mx-auto max-lg:left-0 max-lg:right-0 max-lg:p-4 max-lg:border-2 max-lg:border-solid max-lg:border-black max-lg:dark:border-white max-lg:bg-lt-code-bg max-lg:dark:bg-dk-code-bg"
  >
  {navItems.map((item) => (
    <li>
      <a
        class="px-4 py-3 text-base font-menu block lg:mx-2 lg:py-1 lg:text-lg"
        href={item.href}
        aria-current={getCurrentState(item.href)}
        data-current-section={isCurrentSection(item.href) || undefined}
      >
        {item.label}
      </a>
    </li>
  ))}
</ul>
</nav>

<script>

  const subButton = document.querySelector('#main-menu-toggle');

  subButton?.addEventListener('click', () => {
    const currentExpanded = subButton.getAttribute('aria-expanded');
    (currentExpanded == 'true') ? subButton.setAttribute('aria-expanded', 'false') : subButton.setAttribute('aria-expanded', 'true');
  });

  document.querySelector('#main-menu')?.addEventListener('keyup', (event) => {
    if (event instanceof KeyboardEvent && event.key === 'Escape') {
      subButton?.setAttribute('aria-expanded', 'false');
      (subButton as HTMLButtonElement | null)?.focus();
    }
  });

</script>

<style>
  @media (min-width: 64rem) {
    #main-menu > li {
      margin-block: 0.5rem;
    }
  }
</style>
