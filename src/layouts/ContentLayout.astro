---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  summary?: string;
}

const { title, description, summary } = Astro.props;
const hasNavigation = Astro.slots.has('navigation');
---

<BaseLayout title={title} metaDescription={description}>
  <slot name="breadcrumb" slot="breadcrumb" />
  <article class:list={[!hasNavigation && 'my-8 mx-auto max-w-[40em] px-4']}>
    <header data-content-heading class="bodytext">
      <h1>{title}</h1>
      {summary && <p class="introduction">{summary}</p>}
      <slot name="meta" />
    </header>
    <div data-content-body class="bodytext">
      <slot />
    </div>
  </article>
  {hasNavigation && (
    <aside slot="complementary" data-section-navigation-container class="my-8 lg:col-start-2 lg:row-start-1 lg:my-0 lg:sticky lg:top-4">
      <slot name="navigation" />
    </aside>
  )}
</BaseLayout>

<style>
  @media (min-width: 64rem) {
    [data-content-body] > :global(h2:first-child) {
      margin-top: 0;
    }
  }
</style>
