---
import ContentLayout from './ContentLayout.astro';
import LearningPathMeta from '../components/learning-path/LearningPathMeta.astro';
import LearningPathSteps, { type ResolvedContentStep, type ResolvedReferenceStep } from '../components/learning-path/LearningPathSteps.astro';

interface Props {
  title: string;
  description: string;
  summary: string;
  level: string;
  estimatedMinutes: number;
  outcomes: string[];
  steps: Array<ResolvedReferenceStep | ResolvedContentStep>;
}

const { title, description, summary, level, estimatedMinutes, outcomes, steps } = Astro.props;
---
<ContentLayout title={title} description={description} summary={summary}>
  <slot name="breadcrumb" slot="breadcrumb" />
  <slot name="navigation" slot="navigation" />
  <LearningPathMeta slot="meta" level={level} estimatedMinutes={estimatedMinutes} />
  <section aria-labelledby="learning-outcomes-heading" data-learning-outcomes>
    <h2 id="learning-outcomes-heading">What you will learn</h2>
    <ul>
      {outcomes.map((outcome) => <li>{outcome}</li>)}
    </ul>
  </section>
  <LearningPathSteps steps={steps} />
  <slot />
</ContentLayout>
