---
import ContentLayout from './ContentLayout.astro';
import ExerciseFixture from '../components/exercise/ExerciseFixture.astro';
import ExerciseHints from '../components/exercise/ExerciseHints.astro';
import ExerciseInstructions from '../components/exercise/ExerciseInstructions.astro';
import ExerciseMeta from '../components/exercise/ExerciseMeta.astro';
import ExerciseObjectives from '../components/exercise/ExerciseObjectives.astro';
import ExerciseSolution from '../components/exercise/ExerciseSolution.astro';
import ExerciseWorkspace from '../components/exercise/ExerciseWorkspace.astro';

interface Props {
  title: string;
  description: string;
  summary: string;
  difficulty: string;
  estimatedMinutes: number;
  objectives: string[];
  fixture: string;
  hints: string[];
  solution?: {
    summary: string;
    findings: { title: string; explanation: string }[];
  };
}

const { title, description, summary, difficulty, estimatedMinutes, objectives, fixture, hints, solution } = Astro.props;
---

<ContentLayout title={title} description={description} summary={summary}>
  <ExerciseMeta slot="meta" difficulty={difficulty} estimatedMinutes={estimatedMinutes} />
  <ExerciseObjectives objectives={objectives} />
  <ExerciseInstructions><slot /></ExerciseInstructions>
  <ExerciseWorkspace><ExerciseFixture fixtureKey={fixture} /></ExerciseWorkspace>
  <ExerciseHints hints={hints} />
  <ExerciseSolution solution={solution} />
</ContentLayout>
