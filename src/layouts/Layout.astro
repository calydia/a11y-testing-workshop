---
import BaseLayout from './BaseLayout.astro';
import WorkshopCompatibilityStyles from '../components/site/WorkshopCompatibilityStyles.astro';

interface Props {
  title: string;
  metaDescription: string;
  /** Retained temporarily for legacy workshop pages; navigation now reads Astro.url. */
  currentUrl?: string;
}

const { title, metaDescription } = Astro.props;
---

<BaseLayout title={title} metaDescription={metaDescription}>
  <slot />
  <Fragment slot="after-main">
    <slot name="blogs" />
    <WorkshopCompatibilityStyles />
  </Fragment>
</BaseLayout>
