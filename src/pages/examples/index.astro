---
import Layout from '../../layouts/Layout.astro';
---

<Layout
    title="Accessibility examples"
    metaDescription="Practical examples for testing accessibility patterns with assistive technologies and different input methods."
    currentUrl="/examples/"
  >
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto max-w-[40em]">
      <h1 id="skip-target">
        Accessibility examples
      </h1>
      <div>
        <p>Use these examples to test specific accessibility patterns in a focused way. Each group collects related examples so new topics can be added without crowding the main navigation.</p>

        <h2>Example groups</h2>
        <ul>
          <li>
            <a href="/examples/screen-reader/">Screen reader examples</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
