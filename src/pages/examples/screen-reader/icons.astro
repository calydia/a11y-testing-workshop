---
import Layout from '../../../layouts/Layout.astro';
import IconsAndSvgDemo from '../../../components/demonstrations/screen-reader/IconsAndSvgDemo.astro';
import ScreenReaderExamplesNav from '../../../components/ScreenReaderExamplesNav.astro';
---
<Layout title="Accessible icons and SVGs" metaDescription="Examples of accessible and inaccessible SVG icons and CSS generated icons.">
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto grid max-w-[72em] gap-8 lg:grid-cols-[16rem_minmax(0,40em)_16rem] lg:items-start lg:gap-12">
      <div class="min-w-0 lg:col-start-2">
        <h1>Accessible icons and SVGs</h1>
        <p>Meaningful icons need useful accessible names. Decorative icons should remain silent so they do not add noise.</p>
        <section aria-labelledby="legacy-icons-demonstration"><h2 id="legacy-icons-demonstration">Demonstration</h2><IconsAndSvgDemo /></section>
      </div>
      <div class="lg:col-start-3 lg:row-start-1 lg:sticky lg:top-4"><ScreenReaderExamplesNav currentUrl="/examples/screen-reader/icons/" /></div>
    </div>
  </div>
</Layout>
