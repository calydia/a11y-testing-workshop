---
import Layout from '../../../layouts/Layout.astro';
import LanguageChangesDemo from '../../../components/demonstrations/screen-reader/LanguageChangesDemo.astro';
import ScreenReaderExamplesNav from '../../../components/ScreenReaderExamplesNav.astro';
---
<Layout title="Language attributes" metaDescription="Examples showing where to add the lang attribute when part of a page uses another language.">
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto grid max-w-[72em] gap-8 lg:grid-cols-[16rem_minmax(0,40em)_16rem] lg:items-start lg:gap-12">
      <div class="min-w-0 lg:col-start-2">
        <h1>Where to define the language of parts of the page?</h1>
        <p>Language declarations allow compatible screen readers to apply appropriate pronunciation. Descendants inherit the language of their parent.</p>
        <section aria-labelledby="legacy-language-demonstration"><h2 id="legacy-language-demonstration">Demonstration</h2><LanguageChangesDemo /></section>
      </div>
      <div class="lg:col-start-3 lg:row-start-1 lg:sticky lg:top-4"><ScreenReaderExamplesNav currentUrl="/examples/screen-reader/lang/" /></div>
    </div>
  </div>
</Layout>
