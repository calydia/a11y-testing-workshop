---
import Layout from '../../../layouts/Layout.astro';
import ScreenReaderExamplesNav from '../../../components/ScreenReaderExamplesNav.astro';
---

<Layout
    title="Screen reader examples"
    metaDescription="Focused examples for testing headings, links, icons, language changes, and modals with screen readers."
    currentUrl="/examples/screen-reader/"
  >
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto max-w-[40em]">
      <h1 id="skip-target">
        Screen reader examples
      </h1>
      <div>
        <p>These examples focus on patterns that affect how screen readers announce, navigate, and understand page content.</p>
        <ScreenReaderExamplesNav currentUrl="/examples/screen-reader/" />
      </div>
    </div>
  </div>
</Layout>
