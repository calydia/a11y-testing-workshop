---
import Layout from '../../../layouts/Layout.astro';
import PageStructureAndLinksDemo from '../../../components/demonstrations/screen-reader/PageStructureAndLinksDemo.astro';
import ScreenReaderExamplesNav from '../../../components/ScreenReaderExamplesNav.astro';
---
<Layout title="Screen reader link examples" metaDescription="Examples of link text and page structure patterns to test with screen readers.">
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto grid max-w-[72em] gap-8 lg:grid-cols-[16rem_minmax(0,40em)_16rem] lg:items-start lg:gap-12">
      <div class="min-w-0 lg:col-start-2">
        <h1>Help users understand your content</h1>
        <p>Semantic headings communicate page structure, while descriptive links help people understand destinations in sequence and in screen-reader element lists.</p>
        <section aria-labelledby="legacy-links-demonstration"><h2 id="legacy-links-demonstration">Demonstration</h2><PageStructureAndLinksDemo /></section>
      </div>
      <div class="lg:col-start-3 lg:row-start-1 lg:sticky lg:top-4"><ScreenReaderExamplesNav currentUrl="/examples/screen-reader/links/" /></div>
    </div>
  </div>
</Layout>
