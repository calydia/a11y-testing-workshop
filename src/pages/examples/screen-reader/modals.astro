---
import Layout from '../../../layouts/Layout.astro';
import ModalDialogsDemo from '../../../components/demonstrations/screen-reader/ModalDialogsDemo.astro';
import ScreenReaderExamplesNav from '../../../components/ScreenReaderExamplesNav.astro';
---
<Layout title="Accessible modal examples" metaDescription="Examples of accessible modal dialogs using ARIA attributes and the HTML dialog element.">
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto grid max-w-[72em] gap-8 lg:grid-cols-[16rem_minmax(0,40em)_16rem] lg:items-start lg:gap-12">
      <div class="min-w-0 lg:col-start-2">
        <h1>More accessible modals</h1>
        <p>Modal dialogs need to move focus inside, contain keyboard focus, make the background unavailable, and restore focus when closed.</p>
        <section aria-labelledby="legacy-modal-demonstration"><h2 id="legacy-modal-demonstration">Demonstration</h2><ModalDialogsDemo /></section>
      </div>
      <div class="lg:col-start-3 lg:row-start-1 lg:sticky lg:top-4"><ScreenReaderExamplesNav currentUrl="/examples/screen-reader/modals/" /></div>
    </div>
  </div>
</Layout>
