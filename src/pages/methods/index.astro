---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionLanding from '../../components/SectionLanding.astro';
import { contentUrl, getVisibleEntries, groupEntriesByCategory } from '../../lib/content';
const groups = groupEntriesByCategory<'testingMethods'>(await getVisibleEntries('testingMethods')).map(({ category, entries }) => ({
  category,
  entries: entries.map((entry) => ({
    href: contentUrl('methods', entry.id), title: entry.data.title, summary: entry.data.summary,
    level: entry.data.skillLevel, estimatedMinutes: entry.data.estimatedMinutes,
  })),
}));
---

<BaseLayout title="Testing methods" metaDescription="Reusable reference guides for performing specific accessibility testing techniques.">
  <Breadcrumbs slot="breadcrumb" items={[{ label: 'Home', href: '/' }, { label: 'Testing methods' }]} />
  <SectionLanding title="Testing methods" introduction="Use these reference guides to learn how to perform specific accessibility testing techniques." groups={groups} />
</BaseLayout>
