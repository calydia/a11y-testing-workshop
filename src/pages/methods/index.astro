---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionLanding from '../../components/SectionLanding.astro';
import { contentUrl, getVisibleEntries } from '../../lib/content';
const entries = (await getVisibleEntries('testingMethods')).map((entry) => ({
  href: contentUrl('methods', entry.id), title: entry.data.title, summary: entry.data.summary,
}));
---

<BaseLayout title="Testing methods" metaDescription="Reusable reference guides for performing specific accessibility testing techniques.">
  <SectionLanding title="Testing methods" introduction="Use these reference guides to learn how to perform specific accessibility testing techniques." entries={entries} />
</BaseLayout>
