---
import { getEntry, render } from 'astro:content';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionNavigation from '../../components/navigation/SectionNavigation.astro';
import MethodLayout from '../../layouts/MethodLayout.astro';
import { contentUrl, createSectionNavigationItems, getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('testingMethods');
  const navigationItems = createSectionNavigationItems(entries, 'methods');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, navigationItems } }));
}

const { entry, navigationItems } = Astro.props;
const { Content } = await render(entry);
const relatedExercises = await Promise.all(entry.data.relatedExercises.map(async (reference) => {
  const exercise = await getEntry(reference);
  if (!exercise) throw new Error(`Unable to resolve Testing method Exercise: ${reference.id}`);
  return {
    title: exercise.data.title,
    summary: exercise.data.summary,
    estimatedMinutes: exercise.data.estimatedMinutes,
    href: contentUrl('exercises', exercise.id),
  };
}));
---

<MethodLayout
  title={entry.data.title}
  description={entry.data.description}
  summary={entry.data.summary}
  demonstration={entry.data.demonstration}
  interpretation={entry.data.interpretation}
  limitations={entry.data.limitations}
  relatedExercises={relatedExercises}
>
  <Breadcrumbs
    slot="breadcrumb"
    items={[{ label: 'Home', href: '/' }, { label: 'Testing methods', href: '/methods/' }, { label: entry.data.title }]}
  />
  <SectionNavigation
    slot="navigation"
    title="Testing methods"
    landingHref="/methods/"
    landingLabel="All Testing methods"
    items={navigationItems}
    currentPath={Astro.url.pathname}
  />
  <Content />
</MethodLayout>
