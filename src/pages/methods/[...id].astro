---
import { render } from 'astro:content';
import MethodLayout from '../../layouts/MethodLayout.astro';
import { getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('testingMethods');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<MethodLayout title={entry.data.title} description={entry.data.description} summary={entry.data.summary}>
  <Content />
</MethodLayout>
