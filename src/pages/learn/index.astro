---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionLanding from '../../components/SectionLanding.astro';
import { contentUrl, getVisibleEntries } from '../../lib/content';
const entries = (await getVisibleEntries('learningPaths')).map((entry) => ({
  href: contentUrl('learn', entry.id), title: entry.data.title, summary: entry.data.summary,
}));
---

<BaseLayout title="Learning paths" metaDescription="Structured, self-guided sequences for learning accessibility testing skills progressively.">
  <Breadcrumbs slot="breadcrumb" items={[{ label: 'Home', href: '/' }, { label: 'Learning paths' }]} />
  <SectionLanding title="Learning paths" introduction="Your first accessibility review is the recommended broad starting point. Practical screen-reader testing offers focused learning you can complete independently or after the first path." entries={entries} />
</BaseLayout>
