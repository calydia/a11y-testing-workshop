---
import { render } from 'astro:content';
import LearningPathLayout from '../../layouts/LearningPathLayout.astro';
import { getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('learningPaths');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<LearningPathLayout title={entry.data.title} description={entry.data.description} summary={entry.data.summary}>
  <Content />
</LearningPathLayout>
