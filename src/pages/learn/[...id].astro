---
import { getEntry, render } from 'astro:content';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionNavigation from '../../components/navigation/SectionNavigation.astro';
import LearningPathLayout from '../../layouts/LearningPathLayout.astro';
import { contentUrl, createSectionNavigationItems, getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('learningPaths');
  const navigationItems = createSectionNavigationItems(entries, 'learn');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, navigationItems } }));
}

const { entry, navigationItems } = Astro.props;
const { Content } = await render(entry);
const resolvedSteps = await Promise.all(entry.data.steps.map(async (step) => {
  if (step.type === 'content') return step;

  const referencedEntry = await getEntry(step.entry);
  if (!referencedEntry) throw new Error(`Unable to resolve Learning path step: ${step.entry.id}`);

  return {
    type: step.type,
    title: referencedEntry.data.title,
    summary: referencedEntry.data.summary,
    estimatedMinutes: referencedEntry.data.estimatedMinutes,
    href: contentUrl(
      step.type === 'method' ? 'methods' : step.type === 'exercise' ? 'exercises' : 'journeys',
      referencedEntry.id,
    ),
  };
}));
---

<LearningPathLayout
  title={entry.data.title}
  description={entry.data.description}
  summary={entry.data.summary}
  level={entry.data.level}
  estimatedMinutes={entry.data.estimatedMinutes}
  outcomes={entry.data.outcomes}
  steps={resolvedSteps}
>
  <Breadcrumbs
    slot="breadcrumb"
    items={[{ label: 'Home', href: '/' }, { label: 'Learning paths', href: '/learn/' }, { label: entry.data.title }]}
  />
  <SectionNavigation
    slot="navigation"
    title="Learning paths"
    landingHref="/learn/"
    landingLabel="All learning paths"
    items={navigationItems}
    currentPath={Astro.url.pathname}
  />
  <Content />
</LearningPathLayout>
