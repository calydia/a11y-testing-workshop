---
import { render } from 'astro:content';
import SectionNavigation from '../../components/navigation/SectionNavigation.astro';
import ExerciseLayout from '../../layouts/ExerciseLayout.astro';
import { createSectionNavigationItems, getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('exercises');
  const navigationItems = createSectionNavigationItems(entries, 'exercises');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, navigationItems } }));
}

const { entry, navigationItems } = Astro.props;
const { Content } = await render(entry);
---

<ExerciseLayout
  title={entry.data.title}
  description={entry.data.description}
  summary={entry.data.summary}
  difficulty={entry.data.difficulty}
  estimatedMinutes={entry.data.estimatedMinutes}
  objectives={entry.data.objectives}
  fixture={entry.data.fixture}
  hints={entry.data.hints}
  solution={entry.data.solution}
>
  <SectionNavigation
    slot="navigation"
    title="Exercises"
    landingHref="/exercises/"
    landingLabel="All exercises"
    items={navigationItems}
    currentPath={Astro.url.pathname}
  />
  <Content />
</ExerciseLayout>
