---
import { render } from 'astro:content';
import ExerciseLayout from '../../layouts/ExerciseLayout.astro';
import { getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('exercises');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ExerciseLayout
  title={entry.data.title}
  description={entry.data.description}
  summary={entry.data.summary}
  difficulty={entry.data.difficulty}
  estimatedMinutes={entry.data.estimatedMinutes}
  objectives={entry.data.objectives}
  fixture={entry.data.fixture}
  hints={entry.data.hints}
  solution={entry.data.solution}
>
  <Content />
</ExerciseLayout>
