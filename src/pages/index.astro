---
import Layout from '../layouts/Layout.astro';
---

<Layout
    metaDescription="Learn and practise accessibility testing through guided paths, reusable methods, focused exercises, and realistic testing journeys." title="Accessibility Testing Lab"
  >
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto max-w-[40em]">
      <h1>
        Accessibility Testing Lab
      </h1>
      <div>
        <p>A hands-on environment for learning and practising accessibility testing.</p>
        <section aria-labelledby="beginner-start-heading">
          <h2 id="beginner-start-heading">New to accessibility testing?</h2>
          <p>Learn one technique at a time and practise it before moving on.</p>
          <p><a href="/learn/your-first-accessibility-review/">Start your first accessibility review</a>.</p>
        </section>
        <ul class="list-disc ml-5">
          <li><a href="/learn/">Learning paths</a> teach testing skills progressively.</li>
          <li><a href="/methods/">Testing methods</a> explain individual techniques you can reuse.</li>
          <li><a href="/exercises/">Exercises</a> give you focused examples to investigate.</li>
          <li><a href="/journeys/">Testing journeys</a> combine techniques in realistic scenarios.</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
