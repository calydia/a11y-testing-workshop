---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  metaDescription="The requested Accessibility Testing Lab page could not be found."
  noindex
>
  <div class="my-8 mx-4 max-w-[80em] lg:mx-auto">
    <div class="mx-auto max-w-[40em]">
      <h1>Page not found</h1>
      <p>The address may be incorrect, or the page may have moved.</p>
      <p><a href="/">Go to the Accessibility Testing Lab home page</a>, or choose a section:</p>
      <ul>
        <li><a href="/learn/">Learning paths</a></li>
        <li><a href="/methods/">Testing methods</a></li>
        <li><a href="/exercises/">Exercises</a></li>
        <li><a href="/journeys/">Testing journeys</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
