---
import { render } from 'astro:content';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionNavigation from '../../components/navigation/SectionNavigation.astro';
import JourneyLayout from '../../layouts/JourneyLayout.astro';
import { createSectionNavigationItems, getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('testingJourneys');
  const navigationItems = createSectionNavigationItems(entries, 'journeys');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, navigationItems } }));
}

const { entry, navigationItems } = Astro.props;
const { Content } = await render(entry);
---

<JourneyLayout title={entry.data.title} description={entry.data.description} summary={entry.data.summary}>
  <Breadcrumbs
    slot="breadcrumb"
    items={[{ label: 'Home', href: '/' }, { label: 'Testing journeys', href: '/journeys/' }, { label: entry.data.title }]}
  />
  <SectionNavigation
    slot="navigation"
    title="Testing journeys"
    landingHref="/journeys/"
    landingLabel="All testing journeys"
    items={navigationItems}
    currentPath={Astro.url.pathname}
  />
  <Content />
</JourneyLayout>
