---
import { getEntry, render } from 'astro:content';
import Breadcrumbs from '../../components/navigation/Breadcrumbs.astro';
import SectionNavigation from '../../components/navigation/SectionNavigation.astro';
import JourneyLayout from '../../layouts/JourneyLayout.astro';
import { contentUrl, createSectionNavigationItems, getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('testingJourneys');
  const navigationItems = createSectionNavigationItems(entries, 'journeys');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry, navigationItems } }));
}

const { entry, navigationItems } = Astro.props;
const { Content } = await render(entry);
const methods = await Promise.all(entry.data.methods.map(async (reference) => {
  const method = await getEntry(reference);
  if (!method) throw new Error(`Unable to resolve Testing journey method: ${reference.id}`);
  return { id: method.id, title: method.data.title, summary: method.data.summary, href: contentUrl('methods', method.id) };
}));
const methodById = new Map(methods.map((method) => [method.id, method]));
const exercises = await Promise.all(entry.data.exercises.map(async (reference) => {
  const exercise = await getEntry(reference);
  if (!exercise) throw new Error(`Unable to resolve Testing journey Exercise: ${reference.id}`);
  return {
    title: exercise.data.title,
    summary: exercise.data.summary,
    estimatedMinutes: exercise.data.estimatedMinutes,
    href: contentUrl('exercises', exercise.id),
  };
}));
const stages = entry.data.stages.map((stage) => ({
  title: stage.title,
  task: stage.task,
  methods: stage.methods.map((reference) => {
    const method = methodById.get(reference.id);
    if (!method) throw new Error(`Stage references a method outside the journey: ${reference.id}`);
    return method;
  }),
}));
---

<JourneyLayout
  title={entry.data.title}
  description={entry.data.description}
  summary={entry.data.summary}
  difficulty={entry.data.difficulty}
  estimatedMinutes={entry.data.estimatedMinutes}
  scenario={entry.data.scenario}
  role={entry.data.role}
  objectives={entry.data.objectives}
  methods={methods}
  exercises={exercises}
  stages={stages}
  deliverables={entry.data.deliverables}
>
  <Breadcrumbs
    slot="breadcrumb"
    items={[{ label: 'Home', href: '/' }, { label: 'Testing journeys', href: '/journeys/' }, { label: entry.data.title }]}
  />
  <SectionNavigation
    slot="navigation"
    title="Testing journeys"
    landingHref="/journeys/"
    landingLabel="All testing journeys"
    items={navigationItems}
    currentPath={Astro.url.pathname}
  />
  <Content />
</JourneyLayout>
