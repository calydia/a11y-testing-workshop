---
import { render } from 'astro:content';
import JourneyLayout from '../../layouts/JourneyLayout.astro';
import { getVisibleEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getVisibleEntries('testingJourneys');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<JourneyLayout title={entry.data.title} description={entry.data.description} summary={entry.data.summary}>
  <Content />
</JourneyLayout>
